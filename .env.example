# Laravel Landing Starter — local development defaults
# Production: APP_ENV=production, APP_DEBUG=false, HTTPS APP_URL/SITE_URL,
# DB_CONNECTION=mysql, CACHE_STORE=database, SESSION_SECURE_COOKIE=true.
APP_NAME="Savy Nails & Spa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=savy_nails_spa
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="website@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# SITE_URL is the production canonical origin; never set to a Vercel demo domain.
# When omitted, falls back to APP_URL. Set explicitly before handoff.
# SITE_URL=https://www.client-domain.example
STARTER_PREVIEW=false
STARTER_SHOWCASE=false
# sync processing works on shared hosting; enable queue only with cron/worker configured.
MEDIA_QUEUE=false
LEAD_NOTIFICATION_EMAIL=
# HTTPS endpoint controlled by the deployer, payload contains lead_id only, not contact details.
LEAD_WEBHOOK_URL=
LEAD_RETENTION_DAYS=180
LEAD_CONSENT_REQUIRED=true
# Configure both keys to enable Turnstile. Secret must never enter frontend or export.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_APP_NAME="${APP_NAME}"
